# Normalize line endings across platforms
* text=auto eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary

# Linguist overrides
CHANGELOG.md linguist-generated=false
LICENSE linguist-generated=true
